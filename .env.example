# Copia este archivo a .env y llena los valores reales. Nunca subas .env
# real a git (ya está en .gitignore).

# --- Base de datos (Supabase / Postgres) ---
DATABASE_URL=""

# --- Sesiones / autenticación ---
# Cualquier cadena larga y aleatoria (usada para firmar cookies de sesión).
AUTH_SECRET=""

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=""
# "true" para usar el ambiente de pruebas (sandbox) de Mercado Pago.
MERCADOPAGO_SANDBOX="false"
# Panel de Mercado Pago → Webhooks → firma secreta. Sin esto, el webhook de
# pagos sigue funcionando pero sin verificar la firma de las notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Correo (Resend) ---
RESEND_API_KEY=""

# --- Subida de imágenes (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- URLs públicas del sitio ---
NEXT_PUBLIC_SITE_URL="https://diose.com.mx"
NEXT_PUBLIC_BASE_URL="https://diose.com.mx"

# --- Monitoreo de errores (Sentry) — opcional, sentry.io ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Analítica (Google Analytics) — opcional, analytics.google.com ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
